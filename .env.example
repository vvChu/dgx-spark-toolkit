## Cấu hình Environment
GATEWAY_PROXY_URL=http://<PROXY_IP>:8045/v1
GATEWAY_PROXY_KEY=sk-<your-proxy-key>
GATEWAY_PROXY_DEFAULT_MODEL=claude-sonnet-4-6

## Local DGX vLLM
VLLM_API_BASE=http://100.83.192.30:8001/v1
VLLM_MODEL_35B=qwen3.5-35b
GATEWAY_LOCAL_URL=http://host.docker.internal:8001/v1
GATEWAY_LOCAL_KEY=unused

## Cloud Fallbacks
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

## System Settings
LITELLM_MASTER_KEY=sk-spark-secure-key-2026
CONSOLE_THEME=monokai
LOG_DIR=logs

## Milvus (for RAG service)
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=iso_19650_docs
