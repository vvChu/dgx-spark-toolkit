# --- AI GATEWAY MASTER CONFIGURATION ---
# Copy this to .env and fill in real values.

# 1. REMOTE PROXY (High Intelligence: Claude 4.5, Gemini 3, GPT-4o)
GATEWAY_PROXY_URL=http://YOUR_PROXY_HOST:8045/v1
GATEWAY_PROXY_KEY=sk-CHANGE_ME
GATEWAY_PROXY_DEFAULT_MODEL=smart-brain

# 2. LOCAL DGX vLLM (High Speed: Qwen 3.5)
VLLM_API_BASE=http://ai-gateway:4000/v1
VLLM_MODEL=rag-core
EVAL_MODEL=rag-core
DEFAULT_RAG_MODEL=rag-core
VLLM_MODEL_CORE=rag-core
VLLM_MODEL_35B=rag-core
EMBEDDING_MODEL=BAAI/bge-m3
GATEWAY_LOCAL_URL=http://YOUR_DGX_IP:8004/v1
GATEWAY_LOCAL_KEY=unused

# 3. CLOUD FALLBACKS (Direct API Access)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GROQ_API_KEY=YOUR_GROQ_KEY

# 4. SYSTEM SETTINGS
LITELLM_MASTER_KEY=sk-CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://litellm:CHANGE_ME@litellm-db:5432/litellm
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
CONSOLE_THEME=monokai
LOG_DIR=logs

# 5. TELEGRAM (notifications)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# 6. RAG OPTIMIZATION
MAX_OCR_CONCURRENCY=2
MAX_WORKERS=2
MAX_DIGITAL_WORKERS=4

# 6a. Pipeline Refactor Settings
IMAGE_PREPROCESS=1
OCR_RENDER_DPI=200
SURYA_DEVICE=auto
CHUNK_MAX_CHARS=14500
CROSS_VALIDATE_OCR=1
REMOVE_WATERMARKS=0

# vLLM Blackwell Optimization (Light model)
VLLM_LIGHT_GPU_UTIL=0.15
VLLM_LIGHT_MAX_LEN=24576

# Viber Claude Gateway (Vertex AI backend)
VIBER_PROXY_URL=https://YOUR_PROXY_URL/v1
VIBER_PROXY_KEY=sk-CHANGE_ME

# 7. VOLUME PATHS (Docker Compose mounts)
LEGAL_DOCS_DIR=/path/to/legal/docs
EXPORT_DIR=/path/to/exports
QWEN35B_MODEL_DIR=/path/to/qwen35b/model
# QWEN35B_SNAPSHOT=0b2752837483aa34b3db6e83e151b150c0e00e49

# 8. RATE LIMITING (optional)
# RATE_LIMIT_API_CAPACITY=30    # Max burst for API endpoints (req/min)
# RATE_LIMIT_ADMIN_CAPACITY=10  # Max burst for admin endpoints (req/min)
