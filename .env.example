## --- AI GATEWAY MASTER CONFIGURATION ---

# 1. REMOTE PROXY (High Intelligence: Claude, Gemini, GPT)
GATEWAY_PROXY_URL=http://<PROXY_IP>:8045/v1
GATEWAY_PROXY_KEY=sk-<your-proxy-key>
GATEWAY_PROXY_DEFAULT_MODEL=smart-brain

# 2. LOCAL DGX vLLM (Functional Aliases)
VLLM_API_BASE=http://ai-gateway:4000/v1
VLLM_MODEL=rag-light
EVAL_MODEL=rag-light
DEFAULT_RAG_MODEL=rag-light
VLLM_MODEL_CORE=rag-core
VLLM_MODEL_35B=rag-core
EMBEDDING_MODEL=BAAI/bge-m3
GATEWAY_LOCAL_URL=http://<HOST_IP>:8004/v1
GATEWAY_LOCAL_KEY=unused

# Host IP for external access (used by frontend and gateway URLs)
HOST_IP=<your-machine-ip>
VITE_API_URL=http://<HOST_IP>:8005

# 3. CLOUD FALLBACKS (Direct API Access)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# 4. SECRETS — REQUIRED, no defaults (all must be set before running)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-<generate-a-strong-random-key>
NEO4J_PASSWORD=<generate-a-strong-password>
LITELLM_DB_PASSWORD=<generate-a-strong-password>
MINIO_ACCESS_KEY=<generate-a-strong-key>
MINIO_SECRET_KEY=<generate-a-strong-secret>
GRAFANA_ADMIN_PASSWORD=<generate-a-strong-password>

# 5. CORS — set to your frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 6. RAG OPTIMIZATION
MAX_OCR_CONCURRENCY=2
MAX_WORKERS=2
MAX_DIGITAL_WORKERS=2

# vLLM Blackwell Optimization (Light model - Qwen3.5-4B)
VLLM_LIGHT_GPU_UTIL=0.12
VLLM_LIGHT_MAX_LEN=16384

## 7. Milvus (for RAG service)
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=legal_docs_v9

# 8. Semantic cache tuning (optional — these are the defaults)
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# 9. HOST PATHS (mapped into Docker containers as bind mounts)
LEGAL_DOCS_DIR=/home/vvc/Public
EXPORT_DIR=/home/vvc/Public/exports
QWEN35B_MODEL_DIR=/home/vvc/.cache/huggingface/hub/models--Qwen--Qwen3.5-35B-A3B-FP8
HF_CACHE_DIR=~/.cache/huggingface

# 10. DATABASE
DATABASE_URL=postgresql://litellm:<password>@litellm-postgres:5432/litellm
