  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 2,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Ingestion Status",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Active Workers",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(ingestion_workers_active)", "legendFormat": "active workers" }]
    },
    {
      "title": "Vision Fallback Ratio",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(rate(vision_fallback_total[5m])) / sum(rate(page_process_total[5m])) * 100", "legendFormat": "% fallback" }]
    },
    {
      "title": "Retrieval Performance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "title": "Search Latency (P95)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_search_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95 latency" }]
    },
    {
      "title": "Timeline Hops Avg",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "rate(rag_graph_timeline_hops_total_sum[5m]) / rate(rag_graph_timeline_hops_total_count[5m])", "legendFormat": "avg hops" }]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["rag", "dgx-spark"],
